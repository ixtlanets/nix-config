[Unit]
Description=HTTPS for direct Nik Code subscriptions
After=network-online.target nikcode-subscriptions.service
Wants=network-online.target

[Service]
Type=simple
User=nikcode-subscriptions-caddy
Group=nikcode-subscriptions-caddy
ExecStart=/opt/nikcode-subscriptions/caddy run --config /etc/nikcode-subscriptions/Caddyfile --adapter caddyfile
Restart=on-failure
RestartSec=3
StateDirectory=nikcode-subscriptions-caddy
StateDirectoryMode=0700
Environment=XDG_DATA_HOME=/var/lib/nikcode-subscriptions-caddy
Environment=XDG_CONFIG_HOME=/var/lib/nikcode-subscriptions-caddy
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LimitCORE=0
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
