{
	# The router forwards TCP/443 only. Do not advertise an unreachable
	# HTTP/3 endpoint to mobile clients.
	servers :443 {
		protocols h1 h2
	}
}

books.nikcode.xyz {
	header {
		Alt-Svc "clear"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
	}

	reverse_proxy audiobookshelf:80
}

pablito.nikcode.xyz {
	header {
		Alt-Svc "clear"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
	}

	# Remote ingress for the zenbook OpenClaw Gateway. Moscow has a Russian
	# public IP, so the phone reaches it directly (no VLESS tunnel needed);
	# Caddy then proxies over Tailscale to the Gateway loopback/LAN listener.
	reverse_proxy 100.114.155.30:18789
}
