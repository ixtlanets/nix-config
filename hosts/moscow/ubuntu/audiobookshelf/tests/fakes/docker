#!/usr/bin/env bash
set -euo pipefail

printf 'docker %s\n' "$*" >>"${FAKE_COMMAND_LOG:?}"

case "$*" in
  "buildx imagetools inspect ghcr.io/advplyr/audiobookshelf:2.36.0")
    cat <<'OUTPUT'
Digest: sha256:180acad33d69c99ed208676465d8edcb268fa46967735579a7810859885b1a8e
linux/arm64 sha256:14a6492c743f2acfa00bcd96ec2a5c0c95e311f567718d29cb3c7f3772dc773f
OUTPUT
    ;;
  "pull --platform linux/arm64 ghcr.io/advplyr/audiobookshelf:2.36.0")
    ;;
  "image inspect ghcr.io/advplyr/audiobookshelf:2.36.0 --format {{.Id}}")
    echo "sha256:28b665b047a1e02474fad2bc703bd2a7489e4e72295f67e431c17f07c63320b3"
    ;;
  "save ghcr.io/advplyr/audiobookshelf:2.36.0")
    echo "fake image archive"
    ;;
  *)
    echo "unexpected fake docker command: $*" >&2
    exit 1
    ;;
esac
