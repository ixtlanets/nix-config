#!/usr/bin/env bash
set -euo pipefail

printf 'tar %s\n' "$*" >>"${FAKE_COMMAND_LOG:?}"

if [[ ${FAKE_TAR_FAIL:-0} == 1 ]]; then
  echo "simulated tar failure" >&2
  exit 1
fi

if [[ -n ${REAL_TAR:-} ]]; then
  exec "$REAL_TAR" "$@"
elif [[ -x /usr/bin/tar ]]; then
  exec /usr/bin/tar "$@"
else
  exec /run/current-system/sw/bin/tar "$@"
fi
