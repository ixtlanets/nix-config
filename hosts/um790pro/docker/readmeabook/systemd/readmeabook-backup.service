[Unit]
Description=Back up ReadMeABook control-plane state
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
LoadCredential=abs-api-token:/etc/readmeabook/secrets/abs-api-token
LoadCredential=publisher-ssh-key:/etc/readmeabook/secrets/publisher-ssh-key
LoadCredential=rmab-config-encryption-key:/etc/readmeabook/secrets/rmab-config-encryption-key
LoadCredential=rmab-api-token:/etc/readmeabook/secrets/rmab-api-token
LoadCredential=rmab-jwt-refresh-secret:/etc/readmeabook/secrets/rmab-jwt-refresh-secret
LoadCredential=rmab-jwt-secret:/etc/readmeabook/secrets/rmab-jwt-secret
LoadCredential=rmab-postgres-password:/etc/readmeabook/secrets/rmab-postgres-password
LoadCredential=transmission-password:/etc/readmeabook/secrets/transmission-password
Environment=READMABOOK_SECRETS_ROOT=%d
ExecStart=/usr/bin/flock --exclusive --timeout 1800 /home/nik/.local/state/readmeabook-publisher /home/nik/.local/share/nix-config-services/readmeabook/scripts/backup.sh --execute
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/backups/readmeabook
