[Unit]
Description=Unpublish one verified ReadMeABook manifest from Moscow
After=network-online.target tailscaled.service
Wants=network-online.target
ConditionPathExists=/home/nik/.config/readmeabook/publisher.json

[Service]
Type=oneshot
User=nik
Group=nik
UMask=0077
LoadCredential=publisher-ssh-key:/etc/readmeabook/secrets/publisher-ssh-key
ExecStart=/usr/bin/flock --exclusive --timeout 1800 /home/nik/.local/state/readmeabook-publisher /usr/bin/python3 /home/nik/.local/share/nix-config-services/readmeabook/scripts/publisher.py --config /home/nik/.config/readmeabook/publisher.json unpublish %i --execute
NoNewPrivileges=true
PrivateTmp=true
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/nik/.local/state/readmeabook-publisher
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
