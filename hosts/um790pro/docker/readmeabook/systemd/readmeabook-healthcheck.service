[Unit]
Description=Read-only health check for the ReadMeABook bundle
After=docker.service readmeabook-publisher.service readmeabook-torrent-policy.service
Requires=docker.service

[Service]
Type=oneshot
User=nik
Group=nik
UMask=0077
LoadCredential=rmab-api-token:/etc/readmeabook/secrets/rmab-api-token
LoadCredential=abs-api-token:/etc/readmeabook/secrets/abs-api-token
LoadCredential=publisher-ssh-key:/etc/readmeabook/secrets/publisher-ssh-key
LoadCredential=transmission-password:/etc/readmeabook/secrets/transmission-password
ExecStart=/home/nik/.local/share/nix-config-services/readmeabook/scripts/healthcheck.sh
NoNewPrivileges=true
PrivateTmp=true
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ProtectHome=read-only
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
