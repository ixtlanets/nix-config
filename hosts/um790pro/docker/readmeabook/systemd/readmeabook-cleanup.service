[Unit]
Description=Remove expired confirmed ReadMeABook staging data
After=readmeabook-publisher.service
ConditionPathExists=/home/nik/.config/readmeabook/publisher.json

[Service]
Type=oneshot
User=nik
Group=nik
UMask=0077
ExecStart=/usr/bin/flock --exclusive --timeout 1800 /home/nik/.local/state/readmeabook-publisher /usr/bin/python3 /home/nik/.local/share/nix-config-services/readmeabook/scripts/publisher.py --config /home/nik/.config/readmeabook/publisher.json cleanup --execute
NoNewPrivileges=true
PrivateTmp=true
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/nik/.local/state/readmeabook-publisher /home/nik/services/readmeabook/staging
