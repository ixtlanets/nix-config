[Unit]
Description=Enforce ReadMeABook download capacity and seeding lifecycle
After=docker.service readmeabook-publisher.service
Requires=docker.service
ConditionPathExists=/home/nik/.config/readmeabook/torrent-policy.json

[Service]
Type=oneshot
User=nik
Group=nik
UMask=0077
LoadCredential=transmission-password:/etc/readmeabook/secrets/transmission-password
ExecStart=/usr/bin/flock --exclusive --timeout 1800 /home/nik/.local/state/readmeabook-publisher /usr/bin/python3 /home/nik/.local/share/nix-config-services/readmeabook/scripts/torrent-policy.py --config /home/nik/.config/readmeabook/torrent-policy.json run --execute
NoNewPrivileges=true
PrivateTmp=true
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/nik/.local/state/readmeabook-publisher
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
